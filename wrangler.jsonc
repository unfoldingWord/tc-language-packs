{
  "name": "tc-language-packs",
  "compatibility_date": "2026-10-06",
  "main": "src/worker/index.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "PACKS",
      "bucket_name": "language-packs-staging"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "REQUESTS",
      "id": "197082f4989e4294ac21aadf44356c9b"
    }
  ],
  "services": [
    {
      "binding": "STAGING",
      "service": "translation-helps-mcp-v2-preview"
    }
  ],
  "vars": {
    "PARTS_COMPAT": "f2.0-u2.3.0-p6000230-q9-a12-t1",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  }
}
